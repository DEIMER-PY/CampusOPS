{
  "name": "campusflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev -w @campusflow/web\" \"npm run dev -w @campusflow/api\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run test -w @campusflow/api",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @campusflow/api",
    "db:validate": "npm run db:validate -w @campusflow/api",
    "db:deploy": "npm run db:deploy -w @campusflow/api",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:integration": "npm run test:integration -w @campusflow/api"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/cli": "0.1.22",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "ctx7": "0.6.1",
    "typescript": "7.0.2"
  }
}
