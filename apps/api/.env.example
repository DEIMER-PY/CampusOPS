PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Runtime: pooled connection; migrations: direct or session pooler URL.
# Never commit real passwords, AI keys or Supabase secret/service_role keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Absolute path to the public CA certificate for hosted PostgreSQL.
# Example from apps/api: /absolute/path/campusflow/apps/api/certs/supabase-ca.crt
DATABASE_SSL_CA_FILE=

# n8n must agree to proposal-only mode. No browser-public URL/secret.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_MODE=

# Optional inline public CA PEM on hosting; prefer file path in local development.
DATABASE_SSL_CA_CERT=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Server-only mail configuration. ACCEPTED is not proof of delivery.
RESEND_API_KEY=
EMAIL_FROM=CampusFlow <onboarding@resend.dev>
NOTIFICATION_RECIPIENT=
