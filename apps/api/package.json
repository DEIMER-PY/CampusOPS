{
  "name": "@campusflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "test:integration": "node --import tsx --test tests/*.integration.ts",
    "db:import-spaces": "node --env-file-if-exists=.env --import tsx scripts/import-spaces.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "cors": "2.8.6",
    "helmet": "8.3.0",
    "express-rate-limit": "8.7.1",
    "zod": "4.6.7",
    "dotenv": "18.0.8",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1",
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/cors": "2.8.19",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "prisma": "7.10.1"
  }
}
