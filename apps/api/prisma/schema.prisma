model Space {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  branchId       String?       @db.Uuid
  name           String        @unique
  capacity       Int
  status         AssetStatus   @default(DISABLED)
  hardwareSpecs  Json?
  source         String
  reservations   Reservation[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  branch         CampusBranch? @relation(fields: [branchId], references: [id])
  @@schema("app_private")
}

model Reservation {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  spaceId        String        @db.Uuid
  userId         String        @db.Uuid
  startAt        DateTime      @db.Timestamptz
  endAt          DateTime      @db.Timestamptz
  attendees      Int
  participants   Json?
  purpose        String
  cancelledAt    DateTime?     @db.Timestamptz
  requesterName  String?
  source         String        @default("WEB")
  note           String?
  relocatedFrom  String?
  createdAt      DateTime      @default(now()) @db.Timestamptz
  space          Space         @relation(fields: [spaceId], references: [id])
  user           Profile       @relation(fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  @@index([userId, createdAt])
  @@schema("app_private")
}

model Resource {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  code           String        @unique
  name           String
  batchCode      String?
  hardwareModel  String?
  status         AssetStatus   @default(DISABLED)
  source         String
  loans          Loan[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  @@schema("app_private")
}

model Loan {
  id         String       @id @default(uuid()) @db.Uuid
  resourceId String       @db.Uuid
  userId     String       @db.Uuid
  createdAt  DateTime     @default(now()) @db.Timestamptz
  returnedAt DateTime?    @db.Timestamptz
  resource   Resource     @relation(fields: [resourceId], references: [id])
  user       Profile      @relation(fields: [userId], references: [id])
  acta       DigitalActa?
  @@index([userId, createdAt])
  @@schema("app_private")
}

model Incident {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String?       @db.Uuid
  userId          String        @db.Uuid
  assetCode       String?
  evidence        Json?
  visual          Json?
  visionStatus    String        @default("NONE")
  visionStartedAt DateTime?     @db.Timestamptz
  communications  Json?
  notification    Json?
  description     String
  aiStatus        String        @default("PENDING")
  triage          Json?
  aiError         String?
  aiStartedAt     DateTime?     @db.Timestamptz
  status          String        @default("OPEN")
  createdAt       DateTime      @default(now()) @db.Timestamptz
  user            Profile       @relation(fields: [userId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])
  @@index([userId, createdAt])
  @@schema("app_private")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @db.Uuid
  action       String
  entityId     String   @db.Uuid
  previousHash String?
  hash         String?
  createdAt    DateTime @default(now()) @db.Timestamptz
  @@index([createdAt])
  @@schema("app_private")
}

model ScheduleBoard {
  id             String    @id @default(uuid()) @db.Uuid
  sourceKey      String    @unique
  sourceHash     String
  title          String
  rooms          Json
  entries        Json
  applicableDate DateTime? @db.Date
  timezone       String    @default("America/Bogota")
  revision       Int       @default(1)
  updatedBy      String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz
  @@schema("app_private")
}

enum MessagePriority {
  NORMAL
  URGENT
  @@schema("app_private")
}

model CommunicationChannel {
  id              String           @id @default(uuid()) @db.Uuid
  slug            String           @unique
  name            String
  description     String
  isBroadcastOnly Boolean          @default(false)
  icon            String           @default("hash")
  createdAt       DateTime         @default(now()) @db.Timestamptz
  messages        ChannelMessage[]
  @@schema("app_private")
}

model ChannelMessage {
  id         String               @id @default(uuid()) @db.Uuid
  channelId  String               @db.Uuid
  authorId   String               @db.Uuid
  authorName String               @default("Usuario")
  authorRole Role                 @default(CLIENT)
  content    String
  priority   MessagePriority      @default(NORMAL)
  mentions   Json?
  createdAt  DateTime             @default(now()) @db.Timestamptz
  channel    CommunicationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author     Profile              @relation(fields: [authorId], references: [id])
  @@index([channelId, createdAt])
  @@schema("app_private")
}

